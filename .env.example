# Phase 1: none of these are required.
# Absence of a key is a mode switch (mock), not an error.

# Sarvam API key for live reviews (used from Phase 4).
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m

# GitHub token for PR integration (used from Phase 5).
GITHUB_TOKEN=

# Optional HMAC secret: when set, /webhook verifies X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=

# Local demos only: allow posting from an UNSIGNED webhook delivery.
# Leave unset in any deployment; the endpoint fails closed without the secret above.
WEBHOOK_ALLOW_UNSIGNED=

# auto  = live when a key exists, otherwise mock
# live  = prefer live, degrade to mock on missing key or failure
# mock  = always offline
REVIEW_MODE=auto

# HTTP timeout in seconds.
REQUEST_TIMEOUT_S=20
